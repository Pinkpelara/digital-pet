# Sillkin environment
# Leave these empty to run the delightful demo locally (seeded catalog, simulated checkout).

NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG_ANALYTICS=true

# Demo / local secrets (safe defaults exist in code — override in production)
DEMO_GRANT_SECRET=sillkin-demo-grant-not-for-production
ADMIN_PASSWORD=sillkin-admin

# Supabase (optional — production auth + inventory)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional — production checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth providers are configured in the Supabase dashboard (Google, Apple, email magic link).
# Do not add a password-first flow.
